# Local development. Copy to .env and fill in. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=chaupal_charcha

# demo = essential + dummy data (dev default). essential = admin + taxonomy + settings + old-WP 301s. off = nothing auto-created.
SEED_MODE=demo

ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@chaupal.com
ADMIN_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME
JWT_EXPIRES=7d

FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000
UPLOAD_DIR=uploads

# Reader email (OTP codes). log = print to stdout (dev); ses = AWS SES v2.
# In production, EMAIL_MODE=log is refused unless ALLOW_OTP_LOG=yes.
EMAIL_MODE=log
EMAIL_FROM="Chaupal Te Charcha <no-reply@example.com>"
AWS_REGION=ap-south-1
ALLOW_OTP_LOG=no

# Web push. Generate once per environment with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:CHANGE_ME@example.com
