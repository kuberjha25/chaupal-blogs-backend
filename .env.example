# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=chaupal_charcha

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
