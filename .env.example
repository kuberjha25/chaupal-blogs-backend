# ---- URLs ----
# Frontend origin (CORS) — local dev
FRONTEND_URL=http://localhost:3000
# Public site URL used in canonical/sitemap data
SITE_URL=http://localhost:3000

# ---- Uploads (webp images). S3 aane pe sirf src/storage.js badlega ----
UPLOAD_DIR=uploads
