# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=chaupal_charcha

# ---- Auto-seed mode ----
# demo      = essential + poora dummy data  (dev/UAT — NODE_ENV!=production da default)
# essential = sirf admin + taxonomy + settings + WP 301s  (production da default)
# off       = kuchh auto-create/seed nahi (managed DB, DBA khud chalayega)
# Khali chhado ta NODE_ENV de hisaab naal default lag janda hai.
SEED_MODE=

# ---- First-boot admin (essential seed ehi use karda) ----
ADMIN_NAME=Kuber Jha
ADMIN_EMAIL=kuber.jha@chaupal.in
ADMIN_PASSWORD=Chaupal@123

# ---- Auth ----
JWT_SECRET=d391fb10e4a284e96e9b9dc1cbe686e362283eeba8907cbd9e857744a5a8609efe9cf2466aa72d5880cb0066f6a0eed8859fefeaf9fc45fbf82c4207ae53adc7
JWT_EXPIRES=7d

# ---- URLs ----
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# ---- Uploads (webp images). S3 aane pe sirf src/storage.js badlega ----
UPLOAD_DIR=uploads
