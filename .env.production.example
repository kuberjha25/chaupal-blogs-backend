# ============ PRODUCTION (blog.chaupal.com) ============
# Prod te server pe copy: cp .env.production.example .env
# ★ = deploy ton pehla ZAROOR badlo

PORT=4000
NODE_ENV=production

# ---- MySQL — prod DB server (managed MySQL ho ta uska host/user/pass) ----
DB_HOST=localhost                      # ★ prod DB host (e.g. RDS/Railway endpoint)
DB_PORT=3306
DB_USER=chaupal_app                    # ★ dedicated app user (root nahi)
DB_PASSWORD=SET_STRONG_DB_PASSWORD     # ★
DB_NAME=chaupal_charcha

# essential = pehli boot te sirf admin + taxonomy + settings + purane-WP 301s.
# Dummy/demo data PROD te kade nahi lagda. DB pehla ton seeded ho ta
# bootstrap kuchh nahi chhedta; chaaho ta baad me 'off' kar do.
SEED_MODE=essential

# ---- First-boot admin — ehi tuhada prod Studio login banega ----
ADMIN_NAME=Ujjwal M.
ADMIN_EMAIL=admin@chaupal.com          # ★ apna real email
ADMIN_PASSWORD=SET_STRONG_ADMIN_PASS   # ★ strong password (Chaupal@123 NAHI)

# ---- Auth ----
JWT_SECRET=ece969967c912b466944bab9c5b24bfa3e4024678de24f4a492e3cf81a6ac83a17745c137b63a90b2aaf6f35b2ec3b9f993fb8adc92cec7b0f98832028960261   # ★ `openssl rand -hex 32` ton banao
JWT_EXPIRES=7d

# ---- URLs ----
FRONTEND_URL=https://blog.chaupal.com  # CORS — frontend da public origin
SITE_URL=https://blog.chaupal.com      # canonical/sitemap URLs isi te bande ne

UPLOAD_DIR=uploads
