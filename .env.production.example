# Production values live on the server in /srv/apps/<slug>/shared/.env. Never commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME

# essential = admin + taxonomy + settings + old-WP 301s. demo = also dummy data. off = nothing auto-created.
SEED_MODE=essential

ADMIN_NAME="Admin"
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME
JWT_EXPIRES=7d

FRONTEND_URL=https://blog.chaupal.com
SITE_URL=https://blog.chaupal.com
UPLOAD_DIR=uploads

# Reader email (OTP codes). ses = AWS SES v2 (instance role credentials). Never use log in production.
EMAIL_MODE=ses
EMAIL_FROM="Chaupal Te Charcha <no-reply@example.com>"
AWS_REGION=ap-south-1
ALLOW_OTP_LOG=no

# Web push. Generate once with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:CHANGE_ME@example.com
